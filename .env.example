# Copy to .env and adjust as needed:
#   cp .env.example .env

# Postgres
POSTGRES_USER=poker
POSTGRES_PASSWORD=poker
POSTGRES_DB=poker
# Host port (container always uses 5432 internally)
POSTGRES_PORT=5433
DATABASE_URL=postgresql://poker:poker@localhost:5433/poker

# Redis
# Host port (container always uses 6379 internally)
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# API
API_PORT=3001
# Roulette WS (same api process/container). Local docker publishes it; prod keeps it internal.
ROULETTE_PORT=3002
JWT_SECRET=change-me-in-production
WEB_ORIGIN=http://localhost:8088

# Web (docker compose serves on 8088; local vite on 5173)
WEB_PORT=8088
# Leave empty in docker so browser uses same-origin /ws and /roulette via nginx proxy
VITE_WS_URL=
