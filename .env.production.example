# Production secrets — copy to .env.production and fill in.
#   cp .env.production.example .env.production

POSTGRES_USER=poker
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=poker

JWT_SECRET=change-me-long-random-secret-min-32-chars

# Public origin browsers use (no trailing slash)
WEB_ORIGIN=https://poker.example.com
SITE_ADDRESS=poker.example.com

HTTP_PORT=80
HTTPS_PORT=443
