# Production secrets — copy to .env.production and fill in.
#   cp .env.production.example .env.production
# Or: DOMAIN=juegapoker.online ./start.sh prod

POSTGRES_USER=poker
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=poker

JWT_SECRET=change-me-long-random-secret-min-32-chars

# Public origin browsers use (no trailing slash).
# This is what the API puts in invite links (joinUrl / QR): https://…/join/<roomId>
WEB_ORIGIN=https://juegapoker.online

# Hostname Caddy binds for TLS (no scheme, no trailing slash).
# With Cloudflare SSL "Full" or "Full (strict)":
SITE_ADDRESS=juegapoker.online
# With Cloudflare SSL "Flexible" (HTTP only on origin), use instead:
# SITE_ADDRESS=http://juegapoker.online

# Roulette listens inside the api container only. Caddy proxies
# wss://<SITE_ADDRESS>/roulette → api:3002. Do NOT open 3002 on the host.
ROULETTE_PORT=3002

HTTP_PORT=80
HTTPS_PORT=443
