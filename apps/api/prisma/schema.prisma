generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Durable room metadata (hot play state lives in memory/Redis).
model Room {
  id           String    @id
  code         String    @unique
  passwordHash String
  hostPlayerId String
  phase        String    @default("LOBBY")
  config       Json
  version      Int       @default(1)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  closedAt     DateTime?
}

model SchemaMeta {
  id        Int      @id @default(1)
  version   String   @default("0.2.0")
  updatedAt DateTime @updatedAt
}
